{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/pr_announce.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/pr_status.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
